.custom-select { position: relative; }
.custom-select__option { overflow: hidden; box-sizing: border-box; display: block; width: 100%; padding: 0px; background-color: transparent; border: 0px; border-radius: 0px; font-family: inherit; white-space: nowrap; text-align: left; text-overflow: ellipsis; cursor: pointer; user-select: none; appearance: none; }
.custom-select__option-wrap { position: relative; }
.custom-select__input { box-sizing: border-box; display: block; width: 100%; padding: 0px; border-width: 1px 0px; border-style: solid; border-radius: 0px; font-family: inherit; appearance: none; }
.custom-select__dropdown { position: absolute; box-sizing: border-box; width: 100%; top: 100%; left: 0px; }
.custom-select--dropup .custom-select__dropdown { top: auto; bottom: 100%; }
.custom-select__option { position: relative; padding: 0.375rem 0.75rem; font-size: 1rem; color: rgb(33, 33, 33); line-height: 1.5; }
.custom-select__option:focus { outline: none; }
.custom-select__option:hover, .custom-select__option:focus { background-color: rgb(249, 249, 249); }
.custom-select__option--value { padding-right: 1.875rem; background-color: rgb(255, 255, 255); border: 1px solid rgb(230, 230, 230); border-radius: 0.25rem; }
.custom-select__option--value::after { position: absolute; box-sizing: border-box; width: 0px; height: 0px; top: 50%; right: 0.75rem; border-width: 0.3rem 0.3rem 0px; border-style: solid; border-color: currentcolor transparent; transform: translateY(-50%); content: ""; }
.custom-select--active .custom-select__option--value::after { transform: translateY(-50%) rotate(-180deg); }
.custom-select--active .custom-select__option--value { border-bottom-color: transparent; border-radius: 0.25rem 0.25rem 0px 0px; }
.custom-select--active .custom-select__option--value:hover, .custom-select--active .custom-select__option--value:focus { background-color: rgb(255, 255, 255); }
.custom-select--dropup.custom-select--active .custom-select__option--value { border-top-color: transparent; border-bottom-color: rgb(230, 230, 230); border-radius: 0px 0px 0.25rem 0.25rem; }
.custom-select__option--selected { background-color: rgb(252, 252, 252); }
.custom-select__option[disabled] { color: rgb(161, 161, 161); cursor: default; }
.custom-select__option[disabled]:hover, .custom-select__option[disabled]:focus { background-color: transparent; }
.custom-select__option-wrap { overflow-y: auto; max-height: 11.25rem; }
.custom-select__option-wrap::-webkit-scrollbar { width: 16px; }
.custom-select__option-wrap::-webkit-scrollbar-thumb { background-color: rgb(230, 230, 230); background-clip: padding-box; border-width: 0px 4px; border-style: solid; border-color: transparent; }
.custom-select__input { position: relative; z-index: 1; height: 2.25rem; margin-top: -1px; padding: 0px 0.75rem; border-color: rgb(230, 230, 230); transform: translateY(1px); font-size: 1rem; color: rgb(33, 33, 33); }
.custom-select__input:focus { outline: none; }
.custom-select--dropup .custom-select__input { border-top-width: 0px; margin-top: 0px; transform: translateY(0px); }
.custom-select__dropdown { overflow: hidden; z-index: 1; top: calc(100% - 1px); background-color: rgb(255, 255, 255); border-width: 0px 1px 1px; border-style: solid; border-color: rgb(230, 230, 230); border-radius: 0px 0px 0.25rem 0.25rem; }
.custom-select--dropup .custom-select__dropdown { bottom: calc(100% - 1px); border-width: 1px 1px 0px; border-radius: 0.25rem 0.25rem 0px 0px; }
